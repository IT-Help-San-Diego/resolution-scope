#!/usr/bin/env bash
# Pre-push gate: make "a gate is only a gate if someone reads it" mechanical,
# so it cannot be skipped by an inattentive commit.
#
# The two red-CI episodes (d36ff770, and f8dd0db9e→af8df7d28) each started on a
# commit that skipped the local gate and stayed red because nobody read the red
# CI — it was masked in the mixed-status commit view by green CodeQL/Deploy
# runs (display-vs-state: two green workflows ≠ a green CI).
#
# Two checks, fired automatically on every push:
#   1. LOCAL GATE (unconditional): fmt + test + strict clippy on every crate the
#      CI `crates` matrix gates (engine, cli, store). Doc/evidence commits skip
#      the local gate by nature; this restores it, so fmt drift is caught before
#      it can ship instead of surfacing as a red CI nobody reads.
#   2. PARENT CI (only for pushes to main): the commit being built ON must not
#      already be red. Fail-open on tooling (gh absent / no run found) so the
#      hook never blocks for a reason it cannot prove; fail-closed on a FOUND
#      red parent.
set -u

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# --- 1) local gate (unconditional) ------------------------------------------
gate_fail=0
for crate in engine cli store; do
  if [ ! -f "$crate/Cargo.toml" ]; then
    continue
  fi
  if ! (cd "$crate" && cargo fmt --check); then
    echo "PRE-PUSH: cargo fmt --check failed in $crate — run 'cargo fmt' and re-commit." >&2
    gate_fail=1
  fi
  if ! (cd "$crate" && cargo test --quiet); then
    echo "PRE-PUSH: cargo test failed in $crate." >&2
    gate_fail=1
  fi
  if ! (cd "$crate" && cargo clippy --all-targets --quiet -- -D warnings); then
    echo "PRE-PUSH: cargo clippy --all-targets -D warnings failed in $crate." >&2
    gate_fail=1
  fi
done
if [ "$gate_fail" -ne 0 ]; then
  echo "PRE-PUSH: local gate red — the push would land a commit that CI would fail." >&2
  exit 1
fi

# --- 1.5) ledger lint: the arrow never points left (policy/LANES.md law) ----
# The routing invariant declares a left arrow a parse error; this makes the
# law mechanical for every pusher, not a convention authors remember. Scoped
# to relay lines (^NAME <-) and entry lines (| ... <-) because the law's own
# prose quotes the character to define it — a whole-file grep flags the
# statute for citing the crime (negative-controlled on first run).
LEDGER_LA="$(printf '\xe2\x86\x90')"
if [ -f policy/LANES.md ] && grep -E -q "^[A-Z][A-Z_ -]* ${LEDGER_LA}|^[^|]*\|.*${LEDGER_LA}" policy/LANES.md; then
  echo "PRE-PUSH: a relay/entry line in policy/LANES.md uses a left arrow — parse error per the routing invariant (SENDER -> RECIPIENT, arrow always right)." >&2
  exit 1
fi

# --- 2) parent-CI gate (only for pushes to main) ----------------------------
# pre-push stdin is FOUR fields per line, not three:
#   <local ref> <local sha> <remote ref> <remote sha>
# Read all four; the ref we gate on is the REMOTE ref (field 3) and the sha we
# query is the REMOTE sha (field 4) — the commit being built ON. (The earlier
# three-field read glued "refs/heads/main <sha>" into one token, so the
# comparison never matched and the gate fell through without ever calling gh:
# the exact "check that cannot fire" this hook exists to prevent.)
remote_sha=""
while read -r _lref _lsha rref rsha; do
  [ "$rref" = "refs/heads/main" ] && remote_sha="$rsha"
done
[ -n "$remote_sha" ] || exit 0

if ! command -v gh >/dev/null 2>&1; then
  echo "PRE-PUSH: gh not found — skipping parent-CI check (fail-open)." >&2
  exit 0
fi

# NOTE the fail-open on empty output: `gh run list --commit <sha>` returns
# nothing when CI has not STARTED yet for that sha — the common case in a fast
# sequence like tonight's (push right after the parent lands). "No run found"
# is NOT "green"; it is "unknown", and we fail open rather than block on
# something unprovable. This means the parent-CI half often does not fire in
# practice — it is a backstop for the case where a red run EXISTS, not a
# guarantee that a run has finished. The local gate is the always-on half.
red_count="$(gh run list --commit "$remote_sha" \
  --json workflowName,conclusion \
  --jq '[.[] | select(.workflowName=="CI" and .conclusion=="failure")] | length' \
  2>/dev/null || echo 0)"

if [ -n "$red_count" ] && [ "$red_count" != "0" ]; then
  echo "PRE-PUSH: parent $remote_sha has a RED CI run on main." >&2
  echo "You are stacking a commit on a broken parent. Fix CI (or run the local" >&2
  echo "gate to confirm it is already green) before pushing." >&2
  exit 1
fi

exit 0
